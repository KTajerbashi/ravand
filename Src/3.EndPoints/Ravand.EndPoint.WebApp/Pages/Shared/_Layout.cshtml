
@using Microsoft.AspNetCore.Mvc.ViewEngines
@inject ICompositeViewEngine Engine

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Ravand</title>

    <meta name="description"
          content="Ravand - Modern Web Application" />

    <meta name="theme-color" content="#0f172a" />

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Ravand.EndPoint.WebApp.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">

                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="brand-icon">R</span>
                    <span class="brand-name">Ravand</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <div class="navbar-actions">

                        @{
                            var loginPartial = Engine.FindView(
                                ViewContext,
                                "_LoginPartial",
                                isMainPage: false);
                        }

                        @if (loginPartial.Success)
                        {
                            await Html.RenderPartialAsync("_LoginPartial");
                        }
                        else
                        {
                            throw new InvalidOperationException(
                                "The default Identity UI layout requires " +
                                "a partial view '_LoginPartial'. " +
                                "Searched locations: " +
                                string.Join(
                                    Environment.NewLine,
                                    loginPartial.SearchedLocations));
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>


    <main class="site-main">

        <div class="container">

            <partial name="_CookieConsentPartial" optional />

            @RenderBody()

        </div>

    </main>


    <footer class="site-footer">

        <div class="container">

            <div class="footer-content">

                <div class="footer-main">

                    <a class="footer-brand"
                       asp-area=""
                       asp-page="/Index">

                        <span class="brand-icon">R</span>
                        <span class="brand-name">Ravand</span>

                    </a>

                    <p class="footer-description">
                        Building modern and reliable digital experiences.
                    </p>

                </div>

                <div class="footer-bottom">

                    <span>
                        &copy; @DateTime.UtcNow.Year Ravand.
                        All rights reserved.
                    </span>

                    @{
                        var foundPrivacy = Url.Page(
                            "/Privacy",
                            new { area = "" });
                    }

                    @if (foundPrivacy != null)
                    {
                        <a asp-area=""
                           asp-page="/Privacy"
                           class="footer-link">
                            Privacy Policy
                        </a>
                    }

                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
